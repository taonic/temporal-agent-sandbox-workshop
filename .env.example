# Copy to .env and adjust. Real environment variables override this file.

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=max

# Model: any OpenAI-compatible endpoint. Default is a local Ollama.
LLM_MODE=openai            # or "scripted" for a deterministic, model-free run
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=ollama

# Sandboxes
SANDBOX_PROVIDER=daytona   # or "local" (tests only: no isolation!)
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=max-analyst-py
LEARNER_ID=you             # labels every sandbox you create, for cleanup

# Timing (seconds) and limits
IDLE_TIMEOUT_S=60
APPROVAL_TIMEOUT_S=180
MAX_STEPS=8
MAX_PARALLEL=3

# Where a browser reaches the Temporal UI
TEMPORAL_UI_URL=http://localhost:8233

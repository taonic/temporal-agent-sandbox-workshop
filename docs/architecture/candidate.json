      "title": "Talking to workflows",
      "items": [
        "Signals: new_data, dismiss (fire-and-forget)",
        "Update: approve_publish, guarded by a validator",
        "Queries: status, state (read-only, for the app)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durability",
      "items": [
        "Every model and sandbox call is a recorded activity",
        "Kill the worker: runs resume, nothing repeats",
        "Approval wait and idle timer are durable timers"
      ]
    },
    {
      "dot": "rose",
      "title": "Cleanup",
      "items": [
        "Cancel a team: each Max stops its sandbox",
        "SandboxWorkflow deletes the sandbox before it ends",
        "Bugs pause a run; only real endings clean up"
      ]
    }

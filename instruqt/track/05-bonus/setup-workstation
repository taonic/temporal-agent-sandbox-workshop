#!/usr/bin/env bash
# Generated by scripts/build_track.py. The script itself is challenges/05-bonus/setup.sh,
# run from the sandbox's clone of the repo.
set -euo pipefail
# Instruqt can start a challenge's scripts before the sandbox setup has finished
# (seen 2026-10-05: challenge setup 15 s ahead of it), so wait for its last step.
for _ in $(seq 1 360); do [ -f /etc/workshop/ready ] && break; sleep 5; done
[ -f /etc/workshop/ready ] || { echo "The sandbox setup never finished; see instruqt track logs." >&2; exit 1; }
# shellcheck disable=SC1091
source /etc/workshop/env
"$WORKDIR/instruqt/bin/write-env"
exec bash "$WORKDIR/challenges/05-bonus/setup.sh"
